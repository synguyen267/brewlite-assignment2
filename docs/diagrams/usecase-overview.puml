@startuml usecase-overview
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 70

actor Customer
actor Staff
actor "Payment Service" as PS

rectangle "<<Business>>BrewLite" {
  usecase "Đăng ký tài khoản" as UC03
  usecase "Xem menu và chi tiết sản phẩm" as UC01
  usecase "Quản lý giỏ hàng" as UC02
  usecase "Đặt và thanh toán đơn hàng" as UC04
  usecase "Xem trạng thái và lịch sử đơn" as UC05
  usecase "Cập nhật trạng thái đơn" as UC06
  usecase "Áp mã khuyến mãi" as UC07
  usecase "Đăng nhập" as UC08
}

Customer -- UC03
Customer -- UC01
Customer -- UC02
Customer -- UC04
Customer -- UC05
Customer -- UC08
Staff -- UC06
UC04 -- PS

UC04 .> UC08 : <<include>>
UC05 .> UC08 : <<include>>
UC06 .> UC08 : <<include>>
UC07 .> UC04 : <<extend>>
@enduml
