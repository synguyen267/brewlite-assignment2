@startuml class-domain
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
hide empty methods

title BrewLite – Class diagram (domain)

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum Size {
  S
  M
  L
}

enum Role <<thiết kế mới>> {
  CUSTOMER
  STAFF
}

enum LoyaltyType <<thiết kế mới>> {
  EARN
  REDEEM
}

class User {
  id : Int
  email : String {unique}
  passwordHash : String
  loyaltyPoints : Int
  createdAt : DateTime
  role : Role
}

class Product {
  id : Int
  name : String
  price : Int
  imageUrl : String
  stock : Int
  version : Int
}

class Order {
  id : Int
  status : OrderStatus
  total : Int
  discount : Int
  promoCode : String [0..1]
  createdAt : DateTime
}

class OrderItem {
  id : Int
  size : Size
  toppings : String [0..*]
  qty : Int
  unitPrice : Int
  lineTotal : Int
}

class Payment {
  id : Int
  idempotencyKey : String [0..1] {unique}
  amount : Int
  method : PaymentMethod
  status : PaymentStatus
  createdAt : DateTime
}

class Promotion <<thiết kế mới>> {
  id : Int
  code : String {unique}
  discountPercent : Int
  startsAt : DateTime
  endsAt : DateTime
  active : Boolean
}

class LoyaltyTransaction <<thiết kế mới>> {
  id : Int
  points : Int
  type : LoyaltyType
  createdAt : DateTime
}

User "1" -- "0..*" Order : đặt
Order "1" *-- "1..*" OrderItem : gồm
OrderItem "0..*" -- "1" Product : tham chiếu
Order "1" -- "0..*" Payment : thanh toán
Order "0..*" -- "0..1" Promotion : áp dụng
User "1" -- "0..*" LoyaltyTransaction : có
LoyaltyTransaction "0..*" -- "0..1" Order : từ đơn

Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
OrderItem ..> Size
User ..> Role
LoyaltyTransaction ..> LoyaltyType

legend right
  Lớp có nhãn <<thiết kế mới>> chưa có trong schema Prisma
  (sẽ thêm ở Sprint 2). Các lớp còn lại khớp schema hiện tại.
endlegend
@enduml
