# Sao chép các biến tương ứng vào tệp thật rồi đổi giá trị. KHÔNG commit tệp thật.

# ---- Backend (NestJS): chép vào apps/api/.env ----
PORT=3001
# Cổng 5433 là cổng PostgreSQL của docker-compose.yml ở máy local
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5433/brewlite
# Đổi thành chuỗi ngẫu nhiên dài; không dùng lại giá trị mẫu này ở production
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
# Origin của web được phép gọi API (nhiều origin cách nhau bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000
# Email của nhân viên quầy (cách nhau bằng dấu phẩy). Tài khoản này phải được
# đăng ký như khách bình thường; được dùng các API /staff/orders.
STAFF_EMAILS=nhanvien@brewlite.vn

# ---- Frontend (Next.js): chép vào apps/web/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:3001
# Chế độ demo: hiện ô giả lập thanh toán thất bại ở trang đơn hàng. Bỏ hoặc đặt false ở production.
NEXT_PUBLIC_DEMO_MODE=true
